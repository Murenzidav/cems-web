# Copy this file to .env.local and fill in the values.
NEXT_PUBLIC_SITE_URL=https://www.cemsltd.rw

# Contact form email (Resend, https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=cemsltd2023@gmail.com
# Must be an address on a domain verified in Resend (not Gmail), e.g. website@cemsltd.rw
RESEND_FROM_EMAIL=

# Optional: Google Analytics 4 (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
